---
// Dev-only route (injected in astro.config.mjs). Never built for production.
// This is the page to look at in light, dark, and 360px when tokens change.
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ThemeToggle from '../components/common/ThemeToggle.astro';
// The sample plates use the catalogue's own photographs rather than remote ones: the
// page is what a colour or metric change is judged against, and it has to show the
// kind of picture the theme is built for -- an object on a near-white sweep.
import jasper from '../assets/objects/jasper-vase.webp';
import ewer from '../assets/objects/rock-crystal-ewer.webp';
import watch from '../assets/objects/champion-repeating-watch.webp';

const colors = [
  '--background',
  '--surface',
  '--foreground',
  '--muted',
  '--border',
  '--rule',
  '--plate',
  '--plate-ink',
  '--plate-muted',
  '--plate-primary',
  '--primary',
  '--primary-hover',
  '--on-primary',
];
const plates = [
  {
    caption: 'Hardstone',
    title: 'Jasper vase',
    src: jasper,
    label: 'Jasper, silver gilt · ca. 1600 · 00-01',
    span: 'md:col-span-2',
  },
  {
    caption: 'Hardstone',
    title: 'Rock crystal ewer',
    src: ewer,
    label: 'Smoky rock crystal, gold · ca. 1680 · 00-02',
    span: '',
  },
  {
    caption: 'Clockwork',
    title: 'Repeating watch',
    src: watch,
    label: 'Gold, enamel · 1780 · 00-03',
    span: '',
  },
];

const sizes = ['text-xs', 'text-sm', 'text-base', 'text-lg', 'text-xl', 'text-2xl', 'text-3xl'];
---

<Base title="Styleguide" noindex>
  <div class="mx-auto max-w-wide space-y-12 px-4 py-12">
    <header class="flex items-baseline justify-between gap-4">
      <h1 class="text-2xl font-bold">Styleguide</h1>
      <ThemeToggle />
    </header>

    <section>
      <h2 class="font-ui text-lg font-semibold">Color</h2>
      <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-3">
        {colors.map((name) => (
          <li class="border-border border p-3">
            <span
              class="block h-10 w-full border border-border"
              style={`background: var(${name})`}
            />
            <code class="font-mono text-xs">{name}</code>
          </li>
        ))}
      </ul>
      <p class="text-muted mt-3 text-sm">
        Contrast is checked by <code class="font-mono">pnpm check:contrast</code>, not by eye.
      </p>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Type scale</h2>
      <dl class="mt-4 space-y-2">
        {sizes.map((size) => (
          <div class="flex items-baseline gap-4">
            <dt class="font-mono text-muted w-24 shrink-0 text-xs">{size}</dt>
            <dd class={size}>The quick brown fox jumps over the lazy dog</dd>
          </div>
        ))}
      </dl>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Body copy</h2>
      <div class="max-w-content mt-4">
        <p>
          Body text runs at the measure set by <code class="font-mono">--content-width</code>. It
          carries <a href="#">an inline link</a>, <em>emphasis</em>,{' '}
          <strong>strong emphasis</strong>, and <code class="font-mono">inline code</code>.
        </p>
      </div>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Form controls</h2>
      <p class="text-muted mt-2 max-w-content text-sm">
        Native elements styled in <code class="font-mono">global.css</code>, so a form needs markup
        and nothing else. Errors show after a field is left, never while typing — leave the email
        empty and tab out of it to see the border take the accent. There is one button shape.
      </p>

      <form class="mt-6 grid max-w-content gap-5" novalidate>
        <div>
          <label class="font-ui text-sm font-medium" for="sg-name">
            Name
          </label>
          <input class="mt-1.5" id="sg-name" name="name" type="text" placeholder="Ada Example" />
        </div>
        <div>
          <label class="font-ui text-sm font-medium" for="sg-email">
            Email
          </label>
          <input class="mt-1.5" id="sg-email" name="email" type="email" required />
        </div>
        <div>
          <label class="font-ui text-sm font-medium" for="sg-collection">
            Collection
          </label>
          <select class="mt-1.5" id="sg-collection" name="collection">
            <option>Glass and Hardstone</option>
            <option>Silver</option>
            <option>Ceramics</option>
          </select>
        </div>
        <div>
          <label class="font-ui text-sm font-medium" for="sg-message">
            Message
          </label>
          <textarea class="mt-1.5" id="sg-message" name="message" rows="4"></textarea>
        </div>
        <div class="flex items-center gap-4">
          <button class="btn" type="button">
            Send
          </button>
          <button class="btn" type="button" disabled>
            Sent
          </button>
        </div>
      </form>
    </section>

    <section>
      <h2 class="font-ui text-lg font-semibold">Signature — Plate</h2>
      <p class="text-muted mt-2 max-w-content text-sm">
        A 1px rule grid built from <code class="font-mono">gap</code> plus the parent background,
        the object placed at its own proportions and faded at the edge of the photograph, a caption
        above and a cartellino below that hover and keyboard focus reveal. The plate keeps its paper
        background in dark mode: buyers' object photos are usually shot on white.
      </p>

      <div class="mt-6">
        <div class="plate-grid grid-cols-1 md:grid-cols-3">
          {plates.map((plate) => (
            <figure class={`plate ${plate.span}`}>
              <figcaption class="plate__caption">{plate.caption}</figcaption>
              <Image class="plate__object" src={plate.src} alt={plate.title} widths={[480]} />
              <a class="plate__label block text-center no-underline" href="#">
                {plate.label}
              </a>
            </figure>
          ))}
        </div>
      </div>

      <h3 class="font-ui mt-8 text-sm font-semibold">Masthead — Bodoni Moda, opsz 6–96</h3>
      <p class="font-ui mt-2 text-[clamp(2.5rem,9vw,6rem)] leading-[0.95] font-normal tracking-[-0.015em]">
        Arts &amp; Crafts
      </p>
      <p class="text-muted mt-2 text-sm">
        Optical sizing is left on its default (<code class="font-mono">auto</code>), so this line
        renders near opsz 96 while a caption renders near opsz 12. No
        <code class="font-mono">font-variation-settings</code> needed. The face carries no
        <code class="font-mono">dlig</code> or <code class="font-mono">swsh</code>, so the
        reference's swash ampersand is not available — do not design around it.
      </p>

      <h3 class="font-ui mt-8 text-sm font-semibold">features.plate = false</h3>
      <div class="plate-grid is-plain mt-3 grid-cols-1 md:grid-cols-3">
        {plates.map((plate) => (
          <figure class="plate">
            <figcaption class="plate__caption">{plate.caption}</figcaption>
            <Image class="plate__object" src={plate.src} alt={plate.title} widths={[480]} />
          </figure>
        ))}
      </div>
    </section>
  </div>
</Base>
