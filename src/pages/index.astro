---
import Base from '../layouts/Base.astro';
import Plate from '../components/plate/Plate.astro';
import PlateGrid from '../components/plate/PlateGrid.astro';
import { getFeaturedPlates, getGroupsWithCounts, getPlates, groupPath } from '../lib/content';
import { site } from '../config';

const plates = await getFeaturedPlates();
const total = (await getPlates()).length;
const groups = await getGroupsWithCounts();
---

<Base home description={site.description}>
  <section class="max-w-wide mx-auto px-4 pt-14 pb-12 text-center md:pt-24">
    <h1 class="font-ui text-[clamp(3rem,11vw,6.5rem)] leading-[0.95] tracking-[-0.015em]">
      {site.name}
    </h1>
    <p class="text-muted max-w-content mx-auto mt-6 text-lg">{site.description}</p>
    {total > 0 && (
      <p class="text-muted mt-3 text-sm tabular-nums">
        {total} objects, {groups.length} collections
      </p>
    )}
  </section>

  {plates.length > 0 && (
    <section class="max-w-wide mx-auto px-4">
      <div class="border-rule flex items-baseline justify-between gap-4 border-b pb-2">
        <h2 class="font-ui text-lg font-medium">Plates</h2>
        <a href="/catalogue" class="text-sm no-underline">
          The whole catalogue
        </a>
      </div>
      <PlateGrid class="mt-6 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        {plates.map((plate, i) => (
          <Plate plate={plate} priority={i < 3} lcp={i === 0} />
        ))}
      </PlateGrid>
    </section>
  )}

  {groups.length > 0 && (
    <section class="max-w-wide mx-auto px-4 pt-20">
      <h2 class="font-ui text-lg font-medium">Collections</h2>
      <ul class="border-rule mt-4 border-t">
        {groups.map(({ group, count }, i) => (
          <li class="border-rule border-b">
            <a
              href={groupPath(group)}
              class="hover:text-primary grid gap-x-6 gap-y-1 py-5 no-underline sm:grid-cols-[2.5rem_11rem_minmax(0,1fr)_3rem]"
            >
              <span class="text-muted text-sm tabular-nums">
                {String(group.data.order ?? i + 1).padStart(2, '0')}
              </span>
              <span class="font-ui text-xl leading-tight">{group.data.title}</span>
              <span class="text-muted max-w-content text-sm">{group.data.description}</span>
              <span class="text-muted text-sm tabular-nums sm:text-right">
                {count}
                {/* A bare number reads as a stray digit once the row stacks. */}
                <span class="sm:sr-only"> objects</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
