---
// About the studio and how the catalogue is made. A colophon is the page a
// printed catalogue ends on, so the facts about the production sit here as a
// ruled table rather than as a paragraph about the site.
import Base from '../layouts/Base.astro';
import { contact, site } from '../config';
import { getGroups, getPlates } from '../lib/content';

const plates = await getPlates();
const groups = await getGroups();

const production: [string, string][] = [
  ['Typefaces', 'Bodoni Moda for the titling, Spectral for everything read at length.'],
  ['Photographs', 'Taken in the studio against a white sweep, one object at a time.'],
  [
    'Numbering',
    'Two figures for the collection, two for the entry within it. An object that already carries an accession number keeps it.',
  ],
  ['Built with', 'Astro, static files, no tracking scripts.'],
  ['Rights', 'The photographs are the studio’s own and are not released for reuse.'],
];
---

<Base
  title="Colophon"
  description={`${site.author} on the objects in the ${site.name} catalogue, and how the catalogue is made.`}
>
  <div class="max-w-wide mx-auto px-4 pt-14 pb-20 md:pt-20">
    <h1 class="font-ui text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.05]">Colophon</h1>

    <div class="mt-12 grid gap-12 md:grid-cols-[minmax(0,34rem)_minmax(0,1fr)] md:gap-16">
      <div class="prose">
        <p>
          {site.author} keeps this catalogue. It began as a card index of things worth measuring
          twice, and it stayed one after the cards ran out: {plates.length} objects across{' '}
          {groups.length} collections, each entered the same way, each photographed the same way.
        </p>
        <p>
          The studio takes commissions in glass, silver and cabinetwork, and writes the notes that
          go under the plates. A note appears when there is something to say about how a thing was
          made. Most entries have none, which is the honest state of most entries.
        </p>
        <p>
          Anything catalogued here can be seen in person by arrangement. Write to{' '}
          <a href="/contact">the studio</a> with the number under the plate, or to{' '}
          <a href={`mailto:${contact.email}`}>{contact.email}</a>.
        </p>
      </div>

      <dl class="border-rule border-t text-sm">
        {production.map(([term, value]) => (
          <div class="border-rule border-b py-4">
            <dt class="font-ui text-muted">{term}</dt>
            <dd class="mt-1">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</Base>
