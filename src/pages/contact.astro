---
// A plain POST to whatever service src/config.ts names. No script and no validation
// library: the browser already refuses an empty required field and marks a malformed
// address, and the styles for both states live in global.css.
import Base from '../layouts/Base.astro';
import { contact, site } from '../config';
---

<Base
  title="Contact"
  description={`Write about an object in the ${site.name} catalogue, a photograph, or a commission.`}
>
  <div class="max-w-wide mx-auto px-4 pt-14 pb-20 md:pt-20">
    <h1 class="font-ui text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.05]">Enquiries</h1>
    <p class="text-muted max-w-content mt-5 text-lg">
      About an object in the catalogue, a photograph you want to reproduce, or something you would
      like made. Naming the catalogue number saves a round trip.
    </p>

    <div class="mt-12 grid gap-12 md:grid-cols-[minmax(0,32rem)_minmax(0,1fr)] md:gap-16">
      <form class="grid gap-5" action={contact.formEndpoint} method="post">
        <div>
          <label class="font-ui text-sm font-medium" for="name">
            Name
          </label>
          <input class="mt-1.5" id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div>
          <label class="font-ui text-sm font-medium" for="email">
            Email
          </label>
          <input
            class="mt-1.5"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div>
          <label class="font-ui text-sm font-medium" for="object">
            Catalogue number
          </label>
          <input
            class="mt-1.5"
            id="object"
            name="object"
            type="text"
            placeholder="03-04"
            aria-describedby="object-hint"
          />
          <p class="text-muted mt-2 text-sm" id="object-hint">
            Optional. It is printed under every plate, beside the date.
          </p>
        </div>
        <div>
          <label class="font-ui text-sm font-medium" for="message">
            Message
          </label>
          <textarea class="mt-1.5" id="message" name="message" rows="6" required></textarea>
        </div>
        <div>
          <button class="btn" type="submit">
            Send
          </button>
        </div>
      </form>

      <dl class="border-rule border-t text-sm">
        <div class="border-rule flex flex-wrap gap-x-6 gap-y-1 border-b py-4">
          <dt class="font-ui text-muted w-28">Reply</dt>
          <dd class="flex-1">{contact.responseTime}</dd>
        </div>
        <div class="border-rule flex flex-wrap gap-x-6 gap-y-1 border-b py-4">
          <dt class="font-ui text-muted w-28">By email</dt>
          <dd class="flex-1">
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </dd>
        </div>
        <div class="border-rule flex flex-wrap gap-x-6 gap-y-1 border-b py-4">
          <dt class="font-ui text-muted w-28">Photographs</dt>
          <dd class="text-muted flex-1">
            The plates are the studio's own. What you may do with them is on the{' '}
            <a href="/terms">Terms</a> page.
          </dd>
        </div>
      </dl>
    </div>
  </div>
</Base>
