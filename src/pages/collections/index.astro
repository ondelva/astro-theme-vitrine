---
// The contents of the catalogue: every collection, and under it the register of
// what it holds. The home page shows the collections as plates; this is the list
// a catalogue prints at the front, where you read titles and dates in a column.
import Base from '../../layouts/Base.astro';
import { site } from '../../config';
import { getGroups, getPlatesOf, groupPath, platePath } from '../../lib/content';

const groups = await getGroups();
const register = await Promise.all(
  groups.map(async (group, i) => ({
    group,
    number: String(group.data.order ?? i + 1).padStart(2, '0'),
    plates: await getPlatesOf(group),
  })),
);
---

<Base
  title="Collections"
  description={`How the ${site.name} catalogue is divided, and what each division holds.`}
>
  <div class="max-w-wide mx-auto px-4 pt-14 pb-20 md:pt-20">
    <h1 class="font-ui text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.05]">Collections</h1>
    <p class="text-muted max-w-content mt-5 text-lg">
      The divisions are arranged, not alphabetised, and an object belongs to exactly one of them.
    </p>

    {register.map(({ group, number, plates }) => (
      <section class="border-rule mt-16 border-t pt-6">
        <div class="grid gap-x-8 gap-y-4 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
          <div>
            <p class="text-muted text-sm tabular-nums">{number}</p>
            <h2 class="font-ui mt-1 text-2xl leading-tight">
              <a href={groupPath(group)} class="no-underline">
                {group.data.title}
              </a>
            </h2>
            <p class="text-muted mt-3 text-sm">{plates.length} objects</p>
          </div>
          <div>
            <p class="max-w-content">{group.data.description}</p>
            <ol class="border-rule mt-6 border-t text-sm">
              {plates.map((plate) => (
                <li class="border-rule border-b">
                  <a
                    href={platePath(plate)}
                    class="hover:text-primary grid gap-x-6 gap-y-0.5 py-3 no-underline sm:grid-cols-[6.5rem_minmax(0,1fr)_7rem_9rem]"
                  >
                    <span class="text-muted tabular-nums break-words">{plate.number}</span>
                    <span class="font-ui text-base leading-snug">{plate.data.title}</span>
                    <span class="text-muted tabular-nums">{plate.data.dateText}</span>
                    <span class="text-muted">{plate.data.medium}</span>
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    ))}
  </div>
</Base>
