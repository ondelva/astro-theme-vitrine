---
// One collection: its paragraph, then its plates. The caption is off here — it
// labels the classification, and the heading above has just said it.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Plate from '../../components/plate/Plate.astro';
import PlateGrid from '../../components/plate/PlateGrid.astro';
import { getGroups, getPlatesOf } from '../../lib/content';

export const getStaticPaths = (async () =>
  Promise.all(
    (await getGroups()).map(async (group) => ({
      params: { id: group.id },
      props: { group, plates: await getPlatesOf(group) },
    })),
  )) satisfies GetStaticPaths;

const { group, plates } = Astro.props;
---

<Base title={group.data.title} description={group.data.description}>
  <div class="max-w-wide mx-auto px-4 pt-14 pb-20 md:pt-20">
    <div class="border-rule flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 border-b pb-3">
      <h1 class="font-ui text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.05]">{group.data.title}</h1>
      <p class="text-muted text-sm tabular-nums">{plates.length} objects</p>
    </div>
    <p class="max-w-content mt-5 text-lg">{group.data.description}</p>

    {plates.length > 0 ? (
      <PlateGrid class="mt-10 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        {plates.map((plate, i) => (
          <Plate plate={plate} showCaption={false} priority={i < 3} lcp={i === 0} />
        ))}
      </PlateGrid>
    ) : (
      <p class="text-muted mt-10">Nothing is catalogued under this heading yet.</p>
    )}

    <p class="border-rule mt-12 border-t pt-4 text-sm">
      <a href="/collections" class="no-underline">
        ← All collections
      </a>
    </p>
  </div>
</Base>
