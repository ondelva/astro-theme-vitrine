---
import Base from '../layouts/Base.astro';
import { ui } from '../config';

const t = ui.notFound;
---

<Base title={t.title} noindex>
  <div class="mx-auto max-w-content px-4 py-24">
    <h1 class="text-3xl font-bold">{t.title}</h1>
    <p class="mt-4 text-muted">{t.text}</p>
    <p class="mt-4">
      <a href="/">{t.home}</a>
    </p>
  </div>
</Base>
