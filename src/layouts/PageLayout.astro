---
// A page of plain text. Props in .astro, frontmatter (layout:) in .md/.mdx.
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  frontmatter?: { title: string; description?: string };
}
const { title, description } = Astro.props.frontmatter ?? Astro.props;
---

<Base title={title} description={description}>
  <article class="max-w-content mx-auto px-4 pt-14 pb-20 md:pt-20">
    <h1 class="font-ui text-[clamp(2.25rem,6vw,3.5rem)] leading-[1.05]">{title}</h1>
    {description && <p class="text-muted mt-5 text-lg">{description}</p>}
    <div class="prose border-rule mt-10 border-t pt-10">
      <slot />
    </div>
  </article>
</Base>
