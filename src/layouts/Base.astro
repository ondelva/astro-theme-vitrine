---
import type { ComponentProps } from 'astro/types';
import '../styles/global.css';
import SEO from '../components/common/SEO.astro';
import DemoBar from '../components/common/DemoBar.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import Analytics from '../components/common/Analytics.astro';
import { site } from '../config';

type Props = ComponentProps<typeof SEO> & {
  home?: boolean; // the home masthead carries the nameplate, so the header drops it
};
const { home = false, ...seo } = Astro.props;
---

<html lang={Astro.currentLocale ?? site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
    <Analytics />
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <DemoBar />
    <Header home={home} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
