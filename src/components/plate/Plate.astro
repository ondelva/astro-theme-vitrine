---
// One object in its cell: caption above, the object placed inside, the cartellino
// below. The whole cell is one link, stretched from the title.
import { Image } from 'astro:assets';
import { cartellino, platePath, type Plate } from '../../lib/content';

interface Props {
  plate: Plate;
  // Off where the grid is already one caption's worth of objects (a collection page),
  // so the label does not repeat the heading above it.
  showCaption?: boolean;
  priority?: boolean; // first screen: load it eagerly
  // The one image Lighthouse measures as LCP. Hinting more than one dilutes the hint.
  lcp?: boolean;
}
const { plate, showCaption = true, priority = false, lcp = false } = Astro.props;
const wide = plate.data.span === 2;
---

<figure class:list={['plate', wide && 'plate--wide sm:col-span-2']}>
  {showCaption && <figcaption class="plate__caption">{plate.data.caption}</figcaption>}
  <Image
    class="plate__object"
    src={plate.data.image}
    alt={plate.data.title}
    widths={[320, 640, 960]}
    sizes={
      wide
        ? '(min-width: 40rem) 45rem, 92vw'
        : '(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 92vw'
    }
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={lcp ? 'high' : undefined}
  />
  <div class="plate__label">
    <p class="plate__title">
      <a href={platePath(plate)}>{plate.data.title}</a>
    </p>
    <p class="mt-1">{cartellino(plate).join(' · ')}</p>
  </div>
</figure>
