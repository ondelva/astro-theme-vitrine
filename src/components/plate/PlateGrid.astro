---
// The rule grid. Column counts come from the page as utility classes, because the
// right number of columns is a decision about the page, not about the grid.
import { features } from '../../config';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<div class:list={['plate-grid', !features.plate && 'is-plain', className]}>
  <slot />
</div>
