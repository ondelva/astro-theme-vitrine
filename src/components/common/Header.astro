---
// The nameplate is off on the home page, where the masthead block already carries it.
import { features, nav, site } from '../../config';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const path = Astro.url.pathname;
const current = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="border-rule bg-background sticky top-0 z-40 border-b">
  <div class="max-w-wide mx-auto flex flex-wrap items-baseline gap-x-4 gap-y-1 px-4 py-3 sm:gap-x-6">
    {!home && (
      <a href="/" class="font-ui text-lg leading-none no-underline sm:text-xl">
        {site.name}
      </a>
    )}
    <nav
      aria-label="Main"
      class="ms-auto flex flex-wrap items-baseline justify-end gap-x-3 gap-y-1 text-[0.8125rem] sm:gap-x-5 sm:text-sm"
    >
      {nav.header.map((item) => (
        <a
          href={item.href}
          aria-current={current(item.href) ? 'page' : undefined}
          class:list={[
            'hover:text-primary no-underline',
            current(item.href) ? 'text-foreground' : 'text-muted',
          ]}
        >
          {item.label}
        </a>
      ))}
      {features.darkMode && <ThemeToggle />}
    </nav>
  </div>
</header>
