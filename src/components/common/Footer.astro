---
import { Icon } from 'astro-icon/components';
import { nav, site } from '../../config';

const year = new Date().getFullYear();
---

<footer class="border-rule mt-24 border-t">
  <div class="max-w-wide mx-auto px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <p class="font-ui text-2xl leading-none">{site.name}</p>
        <p class="text-muted max-w-content mt-3 text-sm">{site.description}</p>
      </div>
      <div class="flex gap-12">
        {nav.footer.map((group) => (
          <nav aria-label={group.title}>
            <p class="font-ui text-sm font-medium">{group.title}</p>
            <ul class="mt-3 space-y-1.5 text-sm">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-muted hover:text-primary no-underline">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))}
        {nav.social.length > 0 && (
          <nav aria-label="Elsewhere">
            <p class="font-ui text-sm font-medium">Elsewhere</p>
            <ul class="mt-3 flex gap-3">
              {nav.social.map((link) => (
                <li>
                  <a href={link.href} class="text-muted hover:text-primary block py-1 no-underline">
                    <Icon name={link.icon} class="size-5" title={link.label} />
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>
    </div>
    <p class="text-muted mt-12 text-xs">
      © {year} {site.author} ·{' '}
      <a href="https://github.com/ondelva/astro-theme-vitrine">{site.name}</a> theme by ondelva
    </p>
  </div>
</footer>
