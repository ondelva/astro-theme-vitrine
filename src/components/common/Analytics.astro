---
// The analytics slot. One provider, script only, nothing when the provider is null.
// Self-hosted Plausible and Umami serve the script from their own origin (analytics.host).
import { analytics } from '../../config';

const { provider, id, host } = analytics;
const src = {
  plausible: `${host || 'https://plausible.io'}/js/script.js`,
  umami: `${host || 'https://cloud.umami.is'}/script.js`,
  ga4: `https://www.googletagmanager.com/gtag/js?id=${id}`,
};
---

{provider === 'plausible' && id && (
  <script is:inline defer data-domain={id} src={src.plausible}></script>
)}
{provider === 'umami' && id && (
  <script is:inline defer data-website-id={id} src={src.umami}></script>
)}
{provider === 'ga4' && id && (
  <>
    <script is:inline async src={src.ga4}></script>
    <script is:inline define:vars={{ id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        // gtag.js needs the arguments object itself; an array is handled differently.
        // eslint-disable-next-line prefer-rest-params
        window.dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', id);
    </script>
  </>
)}
