---
// Prev/next across a ruled line. Hidden when there is only one page.
import type { Page } from 'astro';

interface Props {
  page: Pick<Page, 'currentPage' | 'lastPage' | 'url'>;
}
const { currentPage, lastPage, url } = Astro.props.page;
---

{lastPage > 1 && (
  <nav
    aria-label="Pagination"
    class="border-rule mt-12 flex items-baseline justify-between gap-4 border-t pt-4 text-sm"
  >
    {url.prev ? (
      <a href={url.prev} rel="prev" class="no-underline">
        ← Back
      </a>
    ) : (
      <span />
    )}
    <span class="text-muted tabular-nums">
      Sheet {currentPage} of {lastPage}
    </span>
    {url.next ? (
      <a href={url.next} rel="next" class="no-underline">
        Further on →
      </a>
    ) : (
      <span />
    )}
  </nav>
)}
