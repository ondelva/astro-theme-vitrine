---
// Demo site only: nothing is rendered unless PUBLIC_DEMO_BUY_URL is set at build time,
// so a buyer's build never carries it. Set it alongside SITE_URL when building the demo.
const href = import.meta.env.PUBLIC_DEMO_BUY_URL;
const label = 'Vitrine (free) demo';
---

{href && (
  <aside class="border-rule bg-foreground text-background border-b">
    <p class="max-w-wide font-ui mx-auto px-4 py-2 text-[0.8125rem] sm:text-sm">
      {label} &middot;{' '}
      <a class="text-background underline underline-offset-2" href={href}>
        See what Pro adds &rarr;
      </a>
    </p>
  </aside>
)}
